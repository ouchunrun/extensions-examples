{
  "name": "Selection Text Copy",
  "version": "1.0.0.5",
  "manifest_version": 3,
  "description": "Selection Text Copy without login",
  "action": {
    "default_icon": "icons/icons8-apple-fruit-48.png"
  },
  "icons": {
    "16": "icons/icons8-apple-fruit-48.png",
    "48": "icons/icons8-apple-fruit-48.png",
    "128": "icons/icons8-apple-fruit-96.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab"
  ]
}
